<%= form_for(@book) do |f| %>
  <%= f.text_field :isbn, size: 20, maxlength: 25, readonly: true %>
  <br>

  <%= f.password_field :isbn, size: 10, maxlenght:15, disabled: true %>
  <br>

  <%= f.text_area :isbn, cols: 40, rows: 10 %>
  <br>

  <label for=""><%= f.radio_button :publish,  'hoge', class: :rd %>hoge</label>
  <label for=""><%= f.radio_button :publish, 'fuga', class: :rd %>fuga</label>
  <label for=""><%= f.radio_button :publish, 'piyo', class: :rd %>piyo</label>

  <label for=""><%= f.check_box :cd, { class: 'chk' }, 'yes', 'no'  %>CD付属?</label>
  <br>

  <%= f.file_field :isbn, size: 10, maxlength: 15 %>
  <br>

  <%= f.hidden_field :isbn %>
  <br>

<% end %>

